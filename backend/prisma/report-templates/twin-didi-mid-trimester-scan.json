{
  "name": "Twin DiDi Mid-trimester Scan",
  "description": "Dichorionic diamniotic twins, mid-trimester anomaly scan",
  "definition": {
    "schemaVersion": 1,
    "baseSize": 11,
    "blocks": [
      {
        "type": "infoTable",
        "rows": [
          {
            "label": "Name",
            "source": "patient.name"
          },
          {
            "label": "Exam Date",
            "source": "visit.date"
          },
          {
            "label": "Date of Birth",
            "source": "patient.dob"
          },
          {
            "label": "LMP",
            "key": "lmp",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "EDD by date",
            "key": "eddByDate",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "Scan quality",
            "key": "scanQuality",
            "default": "Good quality scan"
          },
          {
            "label": "Serial Visit No",
            "key": "serialVisit",
            "default": "1"
          },
          {
            "label": "Referred By prof Dr/",
            "key": "referredBy",
            "boxed": true
          }
        ]
      },
      {
        "type": "title",
        "text": "4D&5D OBSTETRIC SCAN"
      },
      {
        "type": "text",
        "template": "Twin intrauterine pregnancy,"
      },
      {
        "type": "text",
        "template": "**{{chorionicity}}**",
        "fields": {
          "chorionicity": {
            "default": "Dichorionic, Diamniotic."
          }
        }
      },
      {
        "type": "list",
        "items": [
          {
            "template": "{{fetalLife}}",
            "fields": {
              "fetalLife": {
                "default": "Fetal life is positive for both with regular rhythmic heart rate"
              }
            }
          }
        ],
        "style": "bullet"
      },
      {
        "type": "section",
        "title": "Labelling :",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              1,
              3
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "First twin",
                    "bold": true
                  },
                  {
                    "template": "{{labelFirst}}",
                    "fields": {
                      "labelFirst": {
                        "default": "left"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Second twin",
                    "bold": true
                  },
                  {
                    "template": "{{labelSecond}}",
                    "fields": {
                      "labelSecond": {
                        "default": "right"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "title": "Fetal Biometry :",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              1.2,
              2.4,
              1.4,
              1.4
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "",
                    "colSpan": 2
                  },
                  {
                    "template": "First twin",
                    "align": "center",
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "Second twin",
                    "align": "center",
                    "bold": true,
                    "accent": true
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Fetal position",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{positionFirst}}",
                    "fields": {
                      "positionFirst": {
                        "options": [
                          "Cephalic",
                          "Breech",
                          "Transverse"
                        ]
                      }
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{positionSecond}}",
                    "fields": {
                      "positionSecond": {
                        "options": [
                          "Cephalic",
                          "Breech",
                          "Transverse"
                        ]
                      }
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Fetal gender",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{genderFirst}}",
                    "fields": {
                      "genderFirst": {
                        "options": [
                          "Male",
                          "Female"
                        ]
                      }
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{genderSecond}}",
                    "fields": {
                      "genderSecond": {
                        "options": [
                          "Male",
                          "Female"
                        ]
                      }
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Measurement",
                    "rowSpan": 6,
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "Biparietal Diameter (BPD)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{bpdFirst}}",
                    "fields": {
                      "bpdFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{bpdSecond}}",
                    "fields": {
                      "bpdSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Head circumference (HC)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{hcFirst}}",
                    "fields": {
                      "hcFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{hcSecond}}",
                    "fields": {
                      "hcSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Abdominal circumference (AC)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{acFirst}}",
                    "fields": {
                      "acFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{acSecond}}",
                    "fields": {
                      "acSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Femur length (FL)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{flFirst}}",
                    "fields": {
                      "flFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{flSecond}}",
                    "fields": {
                      "flSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Estimated Gestational age",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{egaFirst}}",
                    "fields": {
                      "egaFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{egaSecond}}",
                    "fields": {
                      "egaSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Estimated fetal weight",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{efwFirst}}",
                    "fields": {
                      "efwFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{efwSecond}}",
                    "fields": {
                      "efwSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Discordant Rate",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{discordant}} %  (normal up to 25 %)",
                    "fields": {
                      "discordant": {}
                    },
                    "colSpan": 2
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Amniotic fluid (DVP)",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{dvpFirst}} cm  {{amnioticFirst}}",
                    "fields": {
                      "dvpFirst": {},
                      "amnioticFirst": {
                        "default": "Average"
                      }
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{dvpSecond}} cm  {{amnioticSecond}}",
                    "fields": {
                      "dvpSecond": {},
                      "amnioticSecond": {
                        "default": "Average"
                      }
                    },
                    "align": "center"
                  }
                ]
              }
            ],
            "border": "all"
          }
        ]
      },
      {
        "type": "section",
        "title": "Placenta :-",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "{{placentaFirst}}",
                "fields": {
                  "placentaFirst": {
                    "default": "First Placenta is anterior, with no low dipping away from the IO"
                  }
                }
              },
              {
                "template": "{{placentaSecond}}",
                "fields": {
                  "placentaSecond": {
                    "default": "Second Placenta is posterior, with no low dipping away from the IO"
                  }
                }
              },
              {
                "template": "{{placentaMaturity}}",
                "fields": {
                  "placentaMaturity": {
                    "default": "Both are grade (2) maturity with peripheral calcifications."
                  }
                }
              },
              {
                "template": "{{retroPlacental}}",
                "fields": {
                  "retroPlacental": {
                    "default": "Retro placental space is free, with no separations or focal lesions."
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Sonographic appearance of fetal anatomy",
        "children": [
          {
            "type": "checklistTable",
            "key": "anatomy",
            "columns": [
              {
                "key": "first",
                "label": "First twin",
                "default": "N"
              },
              {
                "key": "second",
                "label": "Second twin",
                "default": "N"
              }
            ],
            "rows": [
              {
                "key": "head",
                "label": "Head",
                "depth": 0,
                "values": false
              },
              {
                "key": "head_shape",
                "label": "Shape",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_csp",
                "label": "Cavum septi pellucidi (CSP)",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_falx",
                "label": "Midline falx",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_thalami",
                "label": "Thalami",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_lv",
                "label": "Lateral ventricle",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_cereb",
                "label": "Cerebellum (TCD)",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_cm",
                "label": "Cisterna magna",
                "depth": 1,
                "values": true
              },
              {
                "key": "face",
                "label": "Face",
                "depth": 0,
                "values": false
              },
              {
                "key": "face_lip",
                "label": "Upper lip",
                "depth": 1,
                "values": true
              },
              {
                "key": "face_profile",
                "label": "Median profile",
                "depth": 1,
                "values": true
              },
              {
                "key": "face_orbits",
                "label": "Orbits",
                "depth": 1,
                "values": true
              },
              {
                "key": "face_nose",
                "label": "Nose",
                "depth": 1,
                "values": true
              },
              {
                "key": "face_nostrils",
                "label": "Nostrils",
                "depth": 1,
                "values": true
              },
              {
                "key": "neck",
                "label": "Neck",
                "depth": 0,
                "values": true
              },
              {
                "key": "thorax",
                "label": "Thorax",
                "depth": 0,
                "values": false
              },
              {
                "key": "thorax_shape",
                "label": "Shape",
                "depth": 1,
                "values": true
              },
              {
                "key": "thorax_masses",
                "label": "No masses",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart",
                "label": "Heart",
                "depth": 0,
                "values": false
              },
              {
                "key": "heart_activity",
                "label": "Heart activity",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_size",
                "label": "Size",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_axis",
                "label": "Cardiac axis",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_4ch",
                "label": "4CH view",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_lvot",
                "label": "Left ventricular outflow tract",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_rvot",
                "label": "Right ventricular outflow tract",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_3v",
                "label": "Three vessels view",
                "depth": 1,
                "values": true
              },
              {
                "key": "abdomen",
                "label": "Abdomen",
                "depth": 0,
                "values": false
              },
              {
                "key": "abd_stomach",
                "label": "Stomach",
                "depth": 1,
                "values": true
              },
              {
                "key": "abd_kidneys",
                "label": "Kidneys",
                "depth": 1,
                "values": true
              },
              {
                "key": "abd_bladder",
                "label": "Urinary bladder",
                "depth": 1,
                "values": true
              },
              {
                "key": "abd_cord",
                "label": "Abdominal cord insertion",
                "depth": 1,
                "values": true
              },
              {
                "key": "abd_vessels",
                "label": "Cord vessels",
                "depth": 1,
                "values": true
              },
              {
                "key": "spine",
                "label": "Spine",
                "depth": 0,
                "values": true
              },
              {
                "key": "limbs",
                "label": "Limbs",
                "depth": 0,
                "values": true,
                "defaults": {
                  "first": "Normal movement",
                  "second": "Normal movement"
                }
              }
            ],
            "labelWidth": 52
          }
        ]
      },
      {
        "type": "section",
        "title": "2D Doppler Studies:",
        "children": [
          {
            "type": "text",
            "template": "(First fetus) Color Doppler examination revealed :",
            "style": "bold"
          },
          {
            "type": "list",
            "items": [
              {
                "template": "Umbilical artery Doppler revealed:-",
                "children": [
                  {
                    "template": "R.I. = {{ua1Ri}} (Normal for gestational age)",
                    "fields": {
                      "ua1Ri": {}
                    }
                  },
                  {
                    "template": "P.I. = {{ua1Pi}} (Normal for gestational age)",
                    "fields": {
                      "ua1Pi": {}
                    }
                  }
                ]
              }
            ],
            "style": "bullet",
            "childStyle": "circle"
          },
          {
            "type": "text",
            "template": "(Second fetus) Color Doppler examination revealed :",
            "style": "bold"
          },
          {
            "type": "list",
            "items": [
              {
                "template": "Umbilical artery Doppler revealed:-",
                "children": [
                  {
                    "template": "R.I. = {{ua2Ri}} (Normal for gestational age)",
                    "fields": {
                      "ua2Ri": {}
                    }
                  },
                  {
                    "template": "P.I. = {{ua2Pi}} (Normal for gestational age)",
                    "fields": {
                      "ua2Pi": {}
                    }
                  }
                ]
              }
            ],
            "style": "bullet",
            "childStyle": "circle"
          }
        ]
      },
      {
        "type": "section",
        "title": "Modified Biophysical profile For both:",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "Breathing Mov. : {{bppBreathing}}.  Trunk movements: {{bppTrunk}}.",
                "fields": {
                  "bppBreathing": {
                    "default": "N"
                  },
                  "bppTrunk": {
                    "default": "N"
                  }
                }
              },
              {
                "template": "Limb Movement (Tone) : {{bppTone}}.  Amniotic fluid: {{bppFluid}}.",
                "fields": {
                  "bppTone": {
                    "default": "N"
                  },
                  "bppFluid": {
                    "default": "N"
                  }
                }
              },
              {
                "template": "Doppler Index: {{dopplerIndex}}",
                "fields": {
                  "dopplerIndex": {
                    "default": "Normal"
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Comment:",
        "children": [
          {
            "type": "freeList",
            "key": "comment",
            "bold": true,
            "default": [
              "Dichorionic, Diamniotic twin pregnancy",
              "Normal Doppler indices"
            ]
          }
        ]
      },
      {
        "type": "signature"
      }
    ]
  }
}