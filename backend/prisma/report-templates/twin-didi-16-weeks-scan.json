{
  "name": "Twin DiDi 16 Weeks Scan",
  "description": "Dichorionic diamniotic twins at 16 weeks",
  "definition": {
    "schemaVersion": 1,
    "baseSize": 11,
    "blocks": [
      {
        "type": "infoTable",
        "rows": [
          {
            "label": "Name",
            "source": "patient.name"
          },
          {
            "label": "Exam Date",
            "source": "visit.date"
          },
          {
            "label": "LMP",
            "key": "lmp",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "EDD by date",
            "key": "eddByDate",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "Scan quality",
            "key": "scanQuality",
            "default": "Good quality scan"
          },
          {
            "label": "Serial Visit No",
            "key": "serialVisit",
            "default": "1"
          },
          {
            "label": "Referred By prof Dr/",
            "key": "referredBy",
            "boxed": true
          }
        ]
      },
      {
        "type": "title",
        "text": "4D&5D OBSTETRIC SCAN"
      },
      {
        "type": "text",
        "template": "Twin intrauterine pregnancy,"
      },
      {
        "type": "text",
        "template": "**{{chorionicity}}**",
        "fields": {
          "chorionicity": {
            "default": "Dichorionic, Diamniotic."
          }
        }
      },
      {
        "type": "list",
        "items": [
          {
            "template": "{{fetalLife}}",
            "fields": {
              "fetalLife": {
                "default": "Fetal life is positive for both with regular rhythmic heart rate"
              }
            }
          }
        ],
        "style": "bullet"
      },
      {
        "type": "section",
        "title": "Labelling :",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              1,
              3
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "First twin",
                    "bold": true
                  },
                  {
                    "template": "{{labelFirst}}",
                    "fields": {
                      "labelFirst": {
                        "placeholder": "Upper/lower, right/left"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Second twin",
                    "bold": true
                  },
                  {
                    "template": "{{labelSecond}}",
                    "fields": {
                      "labelSecond": {
                        "placeholder": "Upper/lower, right/left"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "title": "Fetal Biometry :",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              1.2,
              2.4,
              1.4,
              1.4
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "",
                    "colSpan": 2
                  },
                  {
                    "template": "First twin",
                    "align": "center",
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "Second twin",
                    "align": "center",
                    "bold": true,
                    "accent": true
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Fetal position",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{positionFirst}}",
                    "fields": {
                      "positionFirst": {
                        "options": [
                          "Cephalic",
                          "Breech",
                          "Transverse"
                        ]
                      }
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{positionSecond}}",
                    "fields": {
                      "positionSecond": {
                        "options": [
                          "Cephalic",
                          "Breech",
                          "Transverse"
                        ]
                      }
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Fetal gender",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{genderFirst}}",
                    "fields": {
                      "genderFirst": {
                        "options": [
                          "Male",
                          "Female"
                        ]
                      }
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{genderSecond}}",
                    "fields": {
                      "genderSecond": {
                        "options": [
                          "Male",
                          "Female"
                        ]
                      }
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Measurement",
                    "rowSpan": 6,
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "Biparietal Diameter (BPD)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{bpdFirst}}",
                    "fields": {
                      "bpdFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{bpdSecond}}",
                    "fields": {
                      "bpdSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Head circumference (HC)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{hcFirst}}",
                    "fields": {
                      "hcFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{hcSecond}}",
                    "fields": {
                      "hcSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Abdominal circumference (AC)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{acFirst}}",
                    "fields": {
                      "acFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{acSecond}}",
                    "fields": {
                      "acSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Femur length (FL)",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{flFirst}}",
                    "fields": {
                      "flFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{flSecond}}",
                    "fields": {
                      "flSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Estimated Gestational age",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{egaFirst}}",
                    "fields": {
                      "egaFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{egaSecond}}",
                    "fields": {
                      "egaSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Estimated fetal weight",
                    "align": "center",
                    "bold": true
                  },
                  {
                    "template": "{{efwFirst}}",
                    "fields": {
                      "efwFirst": {}
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{efwSecond}}",
                    "fields": {
                      "efwSecond": {}
                    },
                    "align": "center"
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Discordant Rate",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{discordant}} %  (normal up to 25 %)",
                    "fields": {
                      "discordant": {}
                    },
                    "colSpan": 2
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Amniotic fluid (DVP)",
                    "colSpan": 2,
                    "bold": true,
                    "accent": true
                  },
                  {
                    "template": "{{dvpFirst}} cm  {{amnioticFirst}}",
                    "fields": {
                      "dvpFirst": {},
                      "amnioticFirst": {
                        "default": "Average"
                      }
                    },
                    "align": "center"
                  },
                  {
                    "template": "{{dvpSecond}} cm  {{amnioticSecond}}",
                    "fields": {
                      "dvpSecond": {},
                      "amnioticSecond": {
                        "default": "Average"
                      }
                    },
                    "align": "center"
                  }
                ]
              }
            ],
            "border": "all"
          }
        ]
      },
      {
        "type": "section",
        "title": "Placenta :-",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "{{placentaFirst}}",
                "fields": {
                  "placentaFirst": {
                    "default": "First Placenta is Anterior, with no low dipping away from the IO"
                  }
                }
              },
              {
                "template": "{{placentaSecond}}",
                "fields": {
                  "placentaSecond": {
                    "default": "Second Placenta is fundal posterior, with no low dipping away from the IO"
                  }
                }
              },
              {
                "template": "{{placentaMaturity}}",
                "fields": {
                  "placentaMaturity": {
                    "default": "Both are grade (1) maturity with no peripheral calcifications."
                  }
                }
              },
              {
                "template": "{{retroPlacental}}",
                "fields": {
                  "retroPlacental": {
                    "default": "Retro placental space is free, with no separations or focal lesions."
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "2D Doppler Studies:",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              2,
              1
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "Uterine artery doppler: Right uterine (PI)",
                    "bold": true
                  },
                  {
                    "template": "{{uterineRightPi}}",
                    "fields": {
                      "uterineRightPi": {}
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "Left uterine (PI)",
                    "bold": true
                  },
                  {
                    "template": "{{uterineLeftPi}}",
                    "fields": {
                      "uterineLeftPi": {}
                    }
                  }
                ]
              }
            ],
            "border": "all"
          }
        ]
      },
      {
        "type": "section",
        "title": "Cervical Canal Biometry :",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "Internal Os inner to inner diameter : {{internalOs}}",
                "fields": {
                  "internalOs": {
                    "placeholder": "mm"
                  }
                }
              },
              {
                "template": "Cervical canal length : {{cervicalLength}}",
                "fields": {
                  "cervicalLength": {
                    "placeholder": "mm"
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Modified Biophysical profile For both:",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "Breathing Mov. : {{bppBreathing}}.  Trunk movements: {{bppTrunk}}.",
                "fields": {
                  "bppBreathing": {
                    "default": "N"
                  },
                  "bppTrunk": {
                    "default": "N"
                  }
                }
              },
              {
                "template": "Limb Movement (Tone) : {{bppTone}}.  Amniotic fluid: {{bppFluid}}.",
                "fields": {
                  "bppTone": {
                    "default": "N"
                  },
                  "bppFluid": {
                    "default": "N"
                  }
                }
              },
              {
                "template": "Doppler Index: {{dopplerIndex}}",
                "fields": {
                  "dopplerIndex": {
                    "default": "Normal"
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Comment:",
        "children": [
          {
            "type": "freeList",
            "key": "comment",
            "bold": true,
            "default": [
              "Dichorionic, Diamniotic twin pregnancy",
              "No gross fetal anomaly was detected at scan time",
              "Normal Doppler biometry for both"
            ]
          }
        ]
      },
      {
        "type": "signature"
      }
    ]
  }
}