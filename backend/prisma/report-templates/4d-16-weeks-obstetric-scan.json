{
  "name": "4D 16 Weeks Obstetric Scan",
  "description": "Single fetus scan at 16 weeks",
  "definition": {
    "schemaVersion": 1,
    "baseSize": 11,
    "blocks": [
      {
        "type": "infoTable",
        "rows": [
          {
            "label": "Name",
            "source": "patient.name"
          },
          {
            "label": "Exam Date",
            "source": "visit.date"
          },
          {
            "label": "Date of Birth",
            "source": "patient.dob"
          },
          {
            "label": "LMP",
            "key": "lmp",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "EDD by date",
            "key": "eddByDate",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "EDD by U/S",
            "key": "eddByUs",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "Scan quality",
            "key": "scanQuality",
            "default": "Good quality scan"
          },
          {
            "label": "Serial Visit No",
            "key": "serialVisit",
            "default": "1"
          },
          {
            "label": "Referred By prof Dr/",
            "key": "referredBy",
            "boxed": true
          }
        ]
      },
      {
        "type": "title",
        "text": "4D&5D OBSTETRIC SCAN"
      },
      {
        "type": "text",
        "template": "{{pregnancy}}",
        "fields": {
          "pregnancy": {
            "default": "Single intrauterine pregnancy."
          }
        }
      },
      {
        "type": "list",
        "items": [
          {
            "template": "{{lie}}",
            "fields": {
              "lie": {
                "default": "Longitudinal lie, cephalic presentation at scan time."
              }
            }
          },
          {
            "template": "Fetal life is positive, with FHR = {{fhr}} (regular - rhythmic).",
            "fields": {
              "fhr": {
                "placeholder": "bpm"
              }
            }
          }
        ],
        "style": "bullet"
      },
      {
        "type": "section",
        "title": "Fetal Biometry :",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              3,
              1
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "Measurement",
                    "align": "center",
                    "accent": true
                  },
                  {
                    "template": "mm",
                    "align": "center",
                    "accent": true
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "• Crown rump length (CRL)"
                  },
                  {
                    "template": "{{crl}}",
                    "fields": {
                      "crl": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "• Biparietal Diameter (BPD)"
                  },
                  {
                    "template": "{{bpd}}",
                    "fields": {
                      "bpd": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "• Abdominal circumference (AC)"
                  },
                  {
                    "template": "{{ac}}",
                    "fields": {
                      "ac": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "• Femur length (FL)"
                  },
                  {
                    "template": "{{fl}}",
                    "fields": {
                      "fl": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              }
            ],
            "border": "all",
            "headerRows": 1
          },
          {
            "type": "text",
            "template": "Estimated Gestational Age (EGA) : {{ega}}",
            "fields": {
              "ega": {
                "placeholder": "wks + d"
              }
            },
            "style": "bold"
          },
          {
            "type": "text",
            "template": "Expected fetal weight (EFW) : {{efw}} + 10 %",
            "fields": {
              "efw": {
                "placeholder": "gm"
              }
            },
            "style": "bold"
          }
        ]
      },
      {
        "type": "section",
        "title": "Placenta :",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "label": "Placenta Location:",
                "template": " {{placentaLocation}}",
                "fields": {
                  "placentaLocation": {
                    "default": "is Posterior with no low dipping its lower end away from the IO"
                  }
                }
              },
              {
                "label": "Placental maturity :-",
                "template": " {{placentaMaturity}}",
                "fields": {
                  "placentaMaturity": {
                    "default": "grade (I) maturity without peripheral calcifications."
                  }
                }
              },
              {
                "template": "{{retroPlacental}}",
                "fields": {
                  "retroPlacental": {
                    "default": "Retro placental space is free, with no separations or focal lesions."
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Amniotic Fluid:",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "{{liquor}}",
                "fields": {
                  "liquor": {
                    "default": "Liquor is clear in aspect with average volume"
                  }
                }
              },
              {
                "template": "DVP = {{dvp}} cm (normal range 2: 8 cm)",
                "fields": {
                  "dvp": {}
                }
              }
            ],
            "style": "circle"
          }
        ]
      },
      {
        "type": "section",
        "title": "Fetal Gender :",
        "children": [
          {
            "type": "text",
            "template": "{{fetalGender}}",
            "fields": {
              "fetalGender": {
                "options": [
                  "Male",
                  "Female"
                ]
              }
            }
          }
        ]
      },
      {
        "type": "section",
        "title": "Sonographic appearance of fetal anatomy",
        "children": [
          {
            "type": "checklistTable",
            "key": "anatomy",
            "columns": [
              {
                "key": "n",
                "label": "N",
                "default": "N"
              },
              {
                "key": "ab",
                "label": "Ab"
              },
              {
                "key": "nv",
                "label": "NV"
              }
            ],
            "rows": [
              {
                "key": "head",
                "label": "Head",
                "depth": 0,
                "values": false
              },
              {
                "key": "head_shape",
                "label": "Shape",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_csp",
                "label": "Cavum septi pellucidi (CSP)",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_falx",
                "label": "Midline falx",
                "depth": 1,
                "values": true
              },
              {
                "key": "head_thalami",
                "label": "Thalami",
                "depth": 1,
                "values": true
              },
              {
                "key": "face",
                "label": "Face",
                "depth": 0,
                "values": false
              },
              {
                "key": "face_lip",
                "label": "Upper lip",
                "depth": 1,
                "values": true
              },
              {
                "key": "face_profile",
                "label": "Median profile",
                "depth": 1,
                "values": true
              },
              {
                "key": "face_nose",
                "label": "Nose",
                "depth": 1,
                "values": true
              },
              {
                "key": "neck",
                "label": "Neck",
                "depth": 0,
                "values": true,
                "defaults": {
                  "n": "Nuchal thickness = mm (normal up to 7mm in second trimester)"
                }
              },
              {
                "key": "thorax",
                "label": "Thorax",
                "depth": 0,
                "values": false
              },
              {
                "key": "thorax_shape",
                "label": "Shape",
                "depth": 1,
                "values": true
              },
              {
                "key": "thorax_masses",
                "label": "No masses",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart",
                "label": "Heart",
                "depth": 0,
                "values": false
              },
              {
                "key": "heart_size",
                "label": "Size",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_axis",
                "label": "Cardiac axis",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_4ch",
                "label": "4CH view",
                "depth": 1,
                "values": true
              },
              {
                "key": "heart_3v",
                "label": "Three vessels view",
                "depth": 1,
                "values": true,
                "defaults": {
                  "n": ""
                }
              },
              {
                "key": "abdomen",
                "label": "Abdomen",
                "depth": 0,
                "values": false
              },
              {
                "key": "abd_stomach",
                "label": "Stomach",
                "depth": 1,
                "values": true
              },
              {
                "key": "abd_bladder",
                "label": "Urinary bladder",
                "depth": 1,
                "values": true
              },
              {
                "key": "abd_cord",
                "label": "Abdominal cord insertion",
                "depth": 1,
                "values": true
              },
              {
                "key": "spine",
                "label": "Spine",
                "depth": 0,
                "values": true
              },
              {
                "key": "limbs",
                "label": "Limbs",
                "depth": 0,
                "values": true
              }
            ],
            "labelWidth": 50
          }
        ]
      },
      {
        "type": "section",
        "title": "Color Doppler Studies:",
        "children": [
          {
            "type": "text",
            "template": "Color Doppler examination revealed :",
            "style": "bold"
          },
          {
            "type": "list",
            "items": [
              {
                "template": "{{ductus}}",
                "fields": {
                  "ductus": {
                    "default": "Normal wave form of Ductus venosus"
                  }
                }
              }
            ],
            "style": "circle"
          }
        ]
      },
      {
        "type": "section",
        "title": "Comment:",
        "children": [
          {
            "type": "freeList",
            "key": "comment",
            "bold": true,
            "default": [
              "Single viable intrauterine pregnancy",
              "Adequate anomaly scan at 22-24 weeks is recommended"
            ]
          }
        ]
      },
      {
        "type": "signature"
      }
    ]
  }
}