{
  "name": "2D Obstetric Scan",
  "description": "2D obstetric scan with Doppler",
  "definition": {
    "schemaVersion": 1,
    "baseSize": 11,
    "blocks": [
      {
        "type": "infoTable",
        "rows": [
          {
            "label": "Name",
            "source": "patient.name"
          },
          {
            "label": "Date",
            "source": "visit.date"
          },
          {
            "label": "Date of Birth",
            "source": "patient.dob"
          },
          {
            "label": "LMP",
            "key": "lmp",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "EDD by date",
            "key": "eddByDate",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "EDD by U/S",
            "key": "eddByUs",
            "placeholder": "dd/mm/yyyy"
          },
          {
            "label": "Serial Visit No",
            "key": "serialVisit",
            "default": "1"
          },
          {
            "label": "Referred By prof Dr/",
            "key": "referredBy",
            "boxed": true
          }
        ]
      },
      {
        "type": "title",
        "text": "2D OBSTETRIC SCAN"
      },
      {
        "type": "text",
        "template": "{{pregnancy}}",
        "fields": {
          "pregnancy": {
            "default": "Single intrauterine pregnancy."
          }
        }
      },
      {
        "type": "list",
        "items": [
          {
            "template": "{{lie}}",
            "fields": {
              "lie": {
                "default": "Longitudinal lie, cephalic presentation at scan time."
              }
            }
          },
          {
            "template": "Fetal life is positive, with FHR = {{fhr}} (regular - rhythmic).",
            "fields": {
              "fhr": {
                "placeholder": "bpm"
              }
            }
          }
        ],
        "style": "bullet"
      },
      {
        "type": "section",
        "title": "Fetal Biometry :",
        "children": [
          {
            "type": "gridTable",
            "widths": [
              3,
              1
            ],
            "rows": [
              {
                "cells": [
                  {
                    "template": "• Biparietal Diameter (BPD)"
                  },
                  {
                    "template": "{{bpd}}",
                    "fields": {
                      "bpd": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "• Femur length (FL)"
                  },
                  {
                    "template": "{{fl}}",
                    "fields": {
                      "fl": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              },
              {
                "cells": [
                  {
                    "template": "• Abdominal circumference (AC)"
                  },
                  {
                    "template": "{{ac}}",
                    "fields": {
                      "ac": {
                        "placeholder": "mm"
                      }
                    }
                  }
                ]
              }
            ],
            "border": "all"
          },
          {
            "type": "text",
            "template": "Estimated Gestational age (EGA) : {{ega}}",
            "fields": {
              "ega": {
                "placeholder": "wks + d"
              }
            },
            "style": "bold"
          },
          {
            "type": "text",
            "template": "Estimated fetal weight (EFW) : {{efw}} + 10 %",
            "fields": {
              "efw": {
                "placeholder": "Gm"
              }
            },
            "style": "bold"
          }
        ]
      },
      {
        "type": "section",
        "title": "Placenta :",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "label": "Placenta Location:",
                "template": " {{placentaLocation}}",
                "fields": {
                  "placentaLocation": {
                    "default": "is Anterior with no low dipping away from the IO"
                  }
                }
              },
              {
                "label": "Placental maturity :-",
                "template": " {{placentaMaturity}}",
                "fields": {
                  "placentaMaturity": {
                    "default": "grade (II) maturity with calcifications , scattered placental lakes"
                  }
                }
              },
              {
                "template": "{{retroPlacental}}",
                "fields": {
                  "retroPlacental": {
                    "default": "Retro placental space is free, with no separations or focal lesions."
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Amniotic Fluid:",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "{{liquor}}",
                "fields": {
                  "liquor": {
                    "default": "Liquor is clear in aspect with average volume"
                  }
                }
              },
              {
                "template": "AFI = {{afi}} cm (normal range 10: 20 cm)",
                "fields": {
                  "afi": {}
                }
              },
              {
                "template": "DVP = {{dvp}} cm (normal range 2: 8 cm)",
                "fields": {
                  "dvp": {}
                }
              }
            ],
            "style": "circle"
          }
        ]
      },
      {
        "type": "section",
        "title": "Umbilical cord:",
        "children": [
          {
            "type": "list",
            "items": [
              {
                "template": "{{cordHernia}}",
                "fields": {
                  "cordHernia": {
                    "default": "No umbilical hernia."
                  }
                }
              },
              {
                "template": "Cord Insertion : {{cordInsertion}}",
                "fields": {
                  "cordInsertion": {
                    "default": "Normal ( Central)."
                  }
                }
              }
            ],
            "style": "bullet"
          }
        ]
      },
      {
        "type": "section",
        "title": "Gender :-",
        "children": [
          {
            "type": "text",
            "template": "{{fetalGender}}",
            "fields": {
              "fetalGender": {
                "options": [
                  "Male",
                  "Female"
                ]
              }
            }
          }
        ]
      },
      {
        "type": "section",
        "title": "2 D Doppler Studies:",
        "children": [
          {
            "type": "text",
            "template": "Color Doppler examination revealed :",
            "style": "bold"
          },
          {
            "type": "list",
            "items": [
              {
                "template": "Umbilical artery Doppler revealed:-",
                "children": [
                  {
                    "template": "R.I. = {{uaRi}} (Normal for gestational age)",
                    "fields": {
                      "uaRi": {}
                    }
                  },
                  {
                    "template": "P.I. = {{uaPi}} (Normal for gestational age)",
                    "fields": {
                      "uaPi": {}
                    }
                  }
                ]
              },
              {
                "template": "MCA Doppler revealed:-",
                "children": [
                  {
                    "template": "R.I. = {{mcaRi}} (Normal for gestational age)",
                    "fields": {
                      "mcaRi": {}
                    }
                  },
                  {
                    "template": "P.I. = {{mcaPi}} (Normal for gestational age)",
                    "fields": {
                      "mcaPi": {}
                    }
                  },
                  {
                    "template": "PSV = {{mcaPsv}}",
                    "fields": {
                      "mcaPsv": {}
                    }
                  }
                ]
              }
            ],
            "style": "bullet",
            "childStyle": "circle"
          }
        ]
      },
      {
        "type": "section",
        "title": "Comment:",
        "children": [
          {
            "type": "freeList",
            "key": "comment",
            "bold": true,
            "default": [
              "Single intrauterine pregnancy",
              "Normal Doppler indices"
            ]
          }
        ]
      },
      {
        "type": "signature"
      }
    ]
  }
}