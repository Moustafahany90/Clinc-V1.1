# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# Placeholders only - do not put real production secrets in this file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Ultrasound Clinic"
APP_TIMEZONE=Africa/Cairo
APP_CURRENCY=EGP

# Public origin used for links in emails and CORS checks. The first origin is
# used for emailed links. A comma-separated list is allowed for CORS, but keep
# production to the single public HTTPS origin.
# Development with Docker: http://localhost:8080
# Development with Vite:   http://localhost:5173
APP_ORIGIN=http://localhost:8080

# Bind published ports to loopback. The Caddy proxy is the only front door.
# For Tailscale-only deployments use docker-compose.tailscale.yml, which binds
# 443 to TAILSCALE_IP and publishes no port 80. Do not use docker-compose.tls.yml
# on a Tailscale-only host.
WEB_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1

# Public/Tailscale TLS host name. APP_ORIGIN must be https://<CLINIC_DOMAIN>
# in production and COOKIE_SECURE=true.
# CLINIC_DOMAIN=clinic.example.com

# --- Tailscale-only ingress (docker-compose.tailscale.yml) -------------------
# Non-secret values only. TAILSCALE_IP must be this host's IPv4 from
# `tailscale ip -4` (100.64.0.0/10); never use 0.0.0.0 or a LAN address.
# TAILSCALE_IP=100.x.y.z
# Host directory containing <CLINIC_DOMAIN>.crt and <CLINIC_DOMAIN>.key issued
# by `tailscale cert`. The path is not a secret; the key file must stay 0600 and
# must never be committed or pasted into logs.
# TAILSCALE_CERT_DIR=/etc/clinic/tailscale-certs

# --- Database ---------------------------------------------------------------
# Host port is deliberately non-default to avoid clashing with existing DBs.
# Docker Compose builds its container DATABASE_URL from these three values, so
# keep the password URL-safe (base64url or hex).
POSTGRES_DB=ultrasound_clinic
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_PORT=55432

# Used by a backend run outside Docker (npm run dev). The Compose services
# construct their own URL from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL=postgresql://clinic_app:change-me-local-db-password@localhost:55432/ultrasound_clinic?schema=public

# --- WAL archiving / PITR (optional overlay; NOT enabled by docker-compose.yml)
# docker-compose.pitr.yml is repository configuration only. Do not apply it to
# production without separate authorisation. These values are non-secret.
# Host path must be a dedicated 0700 mount on the approved backup disk, owned
# by the PostgreSQL runtime user. Verify the image's UID before setting owner.
WAL_ARCHIVE_HOST_DIR=/mnt/clinic-backups/wal-archive
WAL_ARCHIVE_TIMEOUT_SECONDS=300
WAL_ARCHIVE_MIN_FREE_MB=512
# Optional inside the container: only set when /dev/disk/by-uuid is mounted.
# The host mount itself must still use the approved UUID in docs/backup-restore.md.
WAL_ARCHIVE_EXPECTED_UUID=
WAL_ARCHIVE_EXPECTED_FSTYPE=ext4
WAL_KEEP_SIZE=128MB
WAL_MAX_SENDERS=10

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cover the refresh cookie only behind HTTPS. Must be true in production.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Production checklist:
#   NODE_ENV=production
#   APP_ORIGIN=https://clinic.example.com
#   COOKIE_SECURE=true
#   TRUST_PROXY=1
#   distinct random JWT secrets, not placeholders
# The backend refuses to start if these are unsafe.

# --- HTTP -------------------------------------------------------------------
PORT=4000
TRUST_PROXY=1
BODY_LIMIT=2mb

# --- Uploads ----------------------------------------------------------------
# Must point OUTSIDE any statically served directory. The value is relative to
# the backend working directory for a local `npm run dev`; Docker Compose
# overrides it with /app/storage/uploads.
UPLOAD_DIR=./storage/uploads
# Keep this below the Nginx client_max_body_size (32 MB) unless both are raised.
MAX_UPLOAD_MB=25

# --- HTML/PDF rendering -----------------------------------------------------
# Chromium render timeout and bounded concurrency. The wait queue is bounded;
# renders arriving when it is full fail fast instead of growing without limit.
PDF_RENDER_TIMEOUT_MS=30000
PDF_MAX_CONCURRENT_RENDERS=2
PDF_MAX_QUEUE_SIZE=4

# --- WhatsApp report delivery (Evolution API / Baileys) ---------------------
# Evolution API is mandatory core infrastructure: it starts automatically with
# `docker compose up -d` (no Compose profile), is internal to clinic_net (no host
# port), and always has API-key authentication enabled. EVOLUTION_API_KEY is
# required by Compose and is used by both the evolution service and the backend
# client. Keep it a real server-side secret: never expose it to the frontend,
# print it, or commit it. Replace the placeholder below before production.
#
# EVOLUTION_API_ENABLED only controls whether the application exposes WhatsApp
# delivery. It stays false here for a fresh local setup with no paired device.
# Delivery is manual and finalized-report-only (WHATSAPP-BAILEYS, QR pairing).
EVOLUTION_API_ENABLED=false
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=replace-me-with-a-long-random-evolution-api-key
EVOLUTION_INSTANCE_NAME=ultrasound_clinic
EVOLUTION_API_TIMEOUT_MS=30000
EVOLUTION_DEFAULT_COUNTRY_CODE=20

# --- Web (build-time) -------------------------------------------------------
# Leave empty to use same-origin /api/v1 (Nginx proxy).
VITE_API_URL=


# --- First-run account ------------------------------------------------------
# Create the first administrator through the web setup wizard.
