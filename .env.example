# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env.
# Placeholders only - do not put real production secrets in this file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Ultrasound Clinic"
APP_TIMEZONE=Africa/Cairo
APP_CURRENCY=EGP

# Public origin used for links in emails and CORS checks. The first origin is
# used for emailed links. A comma-separated list is allowed for CORS, but keep
# production to the single public HTTPS origin.
# Development with Docker: http://localhost:8080
# Development with Vite:   http://localhost:5173
APP_ORIGIN=http://localhost:8080

# Bind published ports to loopback. Only the TLS proxy (docker-compose.tls.yml)
# should be reachable from the clinic network/Internet.
WEB_BIND=127.0.0.1
POSTGRES_BIND=127.0.0.1

# Only used by the optional TLS overlay.
# CLINIC_DOMAIN=clinic.example.com

# --- Database ---------------------------------------------------------------
# Host port is deliberately non-default to avoid clashing with existing DBs.
# Docker Compose builds its container DATABASE_URL from these three values, so
# keep the password URL-safe (base64url or hex).
POSTGRES_DB=ultrasound_clinic
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_PORT=55432

# Used by a backend run outside Docker (npm run dev). The Compose services
# construct their own URL from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL=postgresql://clinic_app:change-me-local-db-password@localhost:55432/ultrasound_clinic?schema=public

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cover the refresh cookie only behind HTTPS. Must be true in production.
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Production checklist:
#   NODE_ENV=production
#   APP_ORIGIN=https://clinic.example.com
#   COOKIE_SECURE=true
#   TRUST_PROXY=1
#   distinct random JWT secrets, not placeholders
# The backend refuses to start if these are unsafe.

# --- HTTP -------------------------------------------------------------------
PORT=4000
TRUST_PROXY=1
BODY_LIMIT=2mb

# --- Uploads ----------------------------------------------------------------
# Must point OUTSIDE any statically served directory. The value is relative to
# the backend working directory for a local `npm run dev`; Docker Compose
# overrides it with /app/storage/uploads.
UPLOAD_DIR=./storage/uploads
# Keep this below the Nginx client_max_body_size (32 MB) unless both are raised.
MAX_UPLOAD_MB=25

# --- Email (optional) -------------------------------------------------------
# Leave EMAIL_ENABLED=false to run entirely without email.
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ultrasound Clinic <no-reply@example.com>"

# Optional Microsoft Graph (only if EMAIL_PROVIDER=graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# --- WhatsApp report delivery (Evolution API / Baileys) ---------------------
# Manual, finalized-report-only delivery through Evolution API (WHATSAPP-BAILEYS).
# Uses QR Code / Baileys pairing. The API key is a server-side secret: never expose
# it to the frontend or commit it.
EVOLUTION_API_ENABLED=false
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=ultrasound_clinic
EVOLUTION_API_TIMEOUT_MS=30000
EVOLUTION_DEFAULT_COUNTRY_CODE=20

# Optional legacy Meta Cloud API settings (deprecated)
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=20
WHATSAPP_TIMEOUT_MS=30000
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --- Web (build-time) -------------------------------------------------------
# Leave empty to use same-origin /api/v1 (Nginx proxy).
VITE_API_URL=


# --- First-run account ------------------------------------------------------
# Create the first administrator through the web setup wizard.
