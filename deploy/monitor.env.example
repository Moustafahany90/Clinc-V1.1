# Phase 7.1 monitor configuration template -- NOT installed by the audit.
# Copy to /etc/clinic/monitor.env on the Ubuntu host, set mode 0600 and owner
# root:root (Phase 8.3.1 verified host: the backup disk is root:root 0700 and
# the only non-system admin account is clinc_server, which cannot read it).
# Then load it with EnvironmentFile= in clinic-monitor.service.
# Leave a value blank to disable that feature. Never commit the populated file.
#
# PB-26 state-directory model (create this ONCE on the target host):
#   install -d -o root -g clinc_server -m 0750 /var/lib/clinic-monitor
# This is the 0750 root:clinc_server state directory required by both units.
# clinic-monitor.service runs root:clinc_server with UMask=0007, and
# clinic-heartbeat-check.service runs clinc_server:clinc_server, so the
# heartbeat is readable by the checker and denied to non-members.

# --- Backup destination (Phase 8.3.1 verified layout; do not change paths) ---
# One approved root. Tier, manifests, logs, quarantine and wal-archive dirs are
# derived from it by scripts/backup-common.sh.
P7_BACKUP_ROOT=/mnt/clinic-backups
P7_BACKUP_UUID=0f21089c-c507-4903-96e5-daf637100d53
P7_BACKUP_FSTYPE=ext4

# --- WAL archive backlog (Phase 9.5) ---
# Read-only filesystem check. Point at the dedicated WAL archive, not db_data.
# Multiple directories must be newline-separated; leave blank to disable.
P7_WAL_DIRS=/mnt/clinic-backups/wal-archive
P7_WAL_COUNT_WARN=50
P7_WAL_COUNT_HIGH=200
P7_WAL_COUNT_CRITICAL=500
P7_WAL_AGE_WARN_SECONDS=900
P7_WAL_AGE_HIGH_SECONDS=3600
P7_WAL_AGE_CRITICAL_SECONDS=7200
# NOTE: the counts/ages above are cumulative for an archive that correctly
# retains old WAL for PITR. Tune them to the approved retention volume, and use
# the PITR freshness check below for the actionable "archiver stalled" signal.

# --- PITR base backup and WAL freshness (Phase 9.6) ---
# New read-only check `pitr` in scripts/p7-check-pitr.sh. It verifies the newest
# pitr_ready base backup, every WAL segment it requires (presence + SHA-256
# sidecar) and the age of the NEWEST archived segment.
P7_WAL_ARCHIVE_DIR=/mnt/clinic-backups/wal-archive
# Weekly base-backup cadence assumption. Confirm with the owner before use.
P7_PITR_AGE_WARN_HOURS=72
P7_PITR_AGE_HIGH_HOURS=168
P7_PITR_AGE_CRIT_HOURS=336
# archive_timeout is 300s in the PITR overlay; 2x/4x/6x that value.
P7_WAL_FRESHNESS_WARN_SECONDS=600
P7_WAL_FRESHNESS_HIGH_SECONDS=1200
P7_WAL_FRESHNESS_CRITICAL_SECONDS=1800

# --- TLS certificate expiry (Phase 9.8/PB-29) ---
# `cert` is a default monitor check. Both variables may be blank; a correctly
# configured host must set at least one or the check reports `unknown`.
# Newline-separated PUBLIC certificate file paths (no private keys).
P7_CERT_FILES=
# Optional additive endpoint mode: newline-separated host:port targets. The
# check opens a TLS connection only to these explicitly configured addresses.
P7_CERT_ENDPOINTS=
P7_CERT_WARN_DAYS=30
P7_CERT_HIGH_DAYS=14
P7_CERT_CRITICAL_DAYS=7
P7_CERT_ENDPOINT_TIMEOUT_SEC=10

# --- Telegram alert delivery (optional) ---
#Bot token from BotFather. Secret: never paste into tickets, logs or command lines.
P7_TELEGRAM_BOT_TOKEN=
#Owner's private chat id (verify it by sending a test message from the bot first).
P7_TELEGRAM_CHAT_ID=
#Leave at the default in production. Only point this at a local mock together
#with P7_ALLOW_INSECURE_TEST=1 in an isolated test environment.
P7_TELEGRAM_API_BASE=https://api.telegram.org
#Short, non-sensitive label shown in alerts (e.g. clinic-ubuntu-01).
P7_HOST_LABEL=
#Test-only escape hatch for the local mock. MUST be 0 in production.
P7_ALLOW_INSECURE_TEST=0

# --- External dead-man's switch (optional; design/hook only) ---
#Full provider callback URL. Secret: treat exactly like the bot token.
P7_HEARTBEAT_URL=

# --- Local JSONL sink rotation ---
#Rotate when the live sink reaches this many bytes (0 disables rotation).
P7_SINK_MAX_BYTES=1048576
#Number of rotated files to retain in addition to the live sink.
P7_SINK_KEEP=5
