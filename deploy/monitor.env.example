# Phase 7.1 monitor configuration template -- NOT installed by the audit.
# Copy to /etc/clinic/monitor.env on the Ubuntu host, set mode 0600 and owner
# root:root (Phase 8.3.1 verified host: the backup disk is root:root 0700 and
# the only non-system admin account is clinc_server, which cannot read it).
# Then load it with EnvironmentFile= in clinic-monitor.service.
# Leave a value blank to disable that feature. Never commit the populated file.

# --- Backup destination (Phase 8.3.1 verified layout; do not change paths) ---
# One approved root. Tier, manifests, logs, quarantine and wal-archive dirs are
# derived from it by scripts/backup-common.sh.
P7_BACKUP_ROOT=/mnt/clinic-backups
P7_BACKUP_UUID=0f21089c-c507-4903-96e5-daf637100d53
P7_BACKUP_FSTYPE=ext4

# --- Telegram alert delivery (optional) ---
#Bot token from BotFather. Secret: never paste into tickets, logs or command lines.
P7_TELEGRAM_BOT_TOKEN=
#Owner's private chat id (verify it by sending a test message from the bot first).
P7_TELEGRAM_CHAT_ID=
#Leave at the default in production. Only point this at a local mock together
#with P7_ALLOW_INSECURE_TEST=1 in an isolated test environment.
P7_TELEGRAM_API_BASE=https://api.telegram.org
#Short, non-sensitive label shown in alerts (e.g. clinic-ubuntu-01).
P7_HOST_LABEL=
#Test-only escape hatch for the local mock. MUST be 0 in production.
P7_ALLOW_INSECURE_TEST=0

# --- External dead-man's switch (optional; design/hook only) ---
#Full provider callback URL. Secret: treat exactly like the bot token.
P7_HEARTBEAT_URL=

# --- Local JSONL sink rotation ---
#Rotate when the live sink reaches this many bytes (0 disables rotation).
P7_SINK_MAX_BYTES=1048576
#Number of rotated files to retain in addition to the live sink.
P7_SINK_KEEP=5
