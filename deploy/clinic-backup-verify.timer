[Unit]
Description=Daily verification of newest logical and PITR base backup sets
Documentation=file:/opt/clinic/docs/backup-restore.md

[Timer]
OnCalendar=*-*-* 04:00:00 Africa/Cairo
Persistent=true
RandomizedDelaySec=10m
Unit=clinic-backup-schedule@verify.service

[Install]
WantedBy=timers.target
