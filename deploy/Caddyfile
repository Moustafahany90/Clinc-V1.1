# Production TLS front door.
#
# Usage:
#   CLINIC_DOMAIN=clinic.example.com docker compose \
#     -f docker-compose.yml -f docker-compose.tls.yml up -d --build
#
# Caddy obtains and renews a public certificate automatically. The web and
# backend ports stay bound to 127.0.0.1 in the base compose file; only Caddy is
# exposed on 80/443. For a purely internal LAN hostname without public DNS, add
# `tls internal` inside the site block and distribute Caddy's root CA to the
# clinic devices.
#
# APP_ORIGIN must be https://<CLINIC_DOMAIN> and COOKIE_SECURE=true when
# NODE_ENV=production; the backend refuses to start otherwise.

# Explicit HTTP-to-HTTPS redirect. Caddy's default automatic HTTPS also does
# this, but declaring it makes the intent testable in an isolated local run
# without requesting a production certificate.
http://{$CLINIC_DOMAIN} {
	redir https://{host}{uri} permanent
}

{$CLINIC_DOMAIN} {
	encode zstd gzip
	# Phase 7.1: logging-only redaction. Strip everything from the first '?' in
	# the logged request URI and delete credential headers. No routing, header,
	# TLS or proxy behaviour is changed.
	log {
		format filter {
			wrap json
			request>uri regexp \?.* ""
			request>headers>Authorization delete
			request>headers>Cookie delete
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	reverse_proxy web:80 {
		header_up X-Real-IP {remote_host}
	}
}
