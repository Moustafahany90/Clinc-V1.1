# Phase 9.8 scheduler configuration template -- NOT installed by the audit.
# Copy to /etc/clinic/backup.env, set mode 0600 and owner root:root, then load
# it with EnvironmentFile= in clinic-backup-schedule@.service. Never commit the
# populated file. All values below are placeholders for the target owner.

# One approved backup mount root and its dedicated WAL archive.
BACKUP_ROOT=/mnt/clinic-backups
WAL_ARCHIVE_DIR=/mnt/clinic-backups/wal-archive
BACKUP_EXPECTED_UUID=<approved-backup-disk-uuid>
BACKUP_EXPECTED_FSTYPE=<approved-filesystem>

# Mandatory pitr-base arguments. The dispatcher converts these into
# --pghost/--pgport/--pguser/--wal-archive-dir; it never logs credentials.
# Use a dedicated least-privilege PostgreSQL role on the target host.
PITR_PGHOST=127.0.0.1
PITR_PGPORT=5432
PITR_PGUSER=<pitr-base-role>
PITR_PGDATABASE=postgres
PITR_TIER=weekly

# Optional recipient for age-encrypted PITR base artifacts.
PITR_AGE_RECIPIENT=

# Fail-closed safety. Never set SCHED_SKIP_MOUNT_CHECK=1 outside an isolated
# synthetic fixture; the repository preflight rejects it in shipped config.
SCHED_SKIP_MOUNT_CHECK=0
SCHED_OVERLAP_SKIP_ALERT_AFTER=3
SCHED_MIN_FREE_MB=1024

# PITR monitor/verifier state. The heartbeat checker must be able to stat the
# heartbeat under the PB-26 state-directory model.
P7_STATE_DIR=/var/lib/clinic-monitor
P7_ALERT_SINK=/var/lib/clinic-monitor/alerts.jsonl
